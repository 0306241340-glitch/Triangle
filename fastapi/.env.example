# Local: de trong, dung SQLite file quiz.db
# Render: dat DATABASE_URL = Postgres Internal Database URL (Render tu cap)
#   Postgres URL cua Render bat dau bang postgres:// -> code tu doi sang postgresql://
DATABASE_URL=sqlite:///./quiz.db
# Service account Firebase (giong ben Express): paste toan bo JSON tren 1 dong,
# hoac de file serviceAccountKey.json canh app/ (KHONG commit file nay)
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"do-vui-ai-thuong", "...": "..."}
